# Copy to .env and fill in. Never commit the real .env file (SEC: "Secret
# management outside source control", SRS Chapter 33.4).

# --- Database --------------------------------------------------------------
# DATABASE_URL / TEST_DATABASE_URL: the RESTRICTED role (NFR-SEC-010) that
# the running app and the tenant-isolation e2e suite connect as. This role
# owns nothing and is not a superuser, so RLS actually applies to it — see
# the "RESTRICTED APPLICATION ROLE" section of
# infra/migrations/0001_init_tenancy.sql for why this matters: the
# migration/owner role (below) bypasses RLS by default even with RLS
# "enabled," so using it here would silently defeat tenant isolation.
#
# NFR-DEP-010 ("local, development, automated test, staging and production
# use separate databases"): TEST_DATABASE_URL points at a SEPARATE database
# (pbsms_test), not dev's pbsms — see apps/api/test/env-setup.ts. One-time
# setup: `createdb`-equivalent `psql -U postgres -c "CREATE DATABASE
# pbsms_test OWNER pbsms;"`, then run `npm run migrate` / `npm run seed`
# (both --workspace apps/api) with MIGRATE_DATABASE_URL temporarily pointed
# at pbsms_test instead of pbsms.
DATABASE_URL=postgres://pbsms_app:pbsms_app_local_only@localhost:5432/pbsms
TEST_DATABASE_URL=postgres://pbsms_app:pbsms_app_local_only@localhost:5432/pbsms_test

# MIGRATE_DATABASE_URL: the schema-owning role, used ONLY by `npm run
# migrate` / `npm run seed`. Never point the running app at this one.
MIGRATE_DATABASE_URL=postgres://pbsms:pbsms_local_only@localhost:5432/pbsms
# TEST_MIGRATE_DATABASE_URL: same role as MIGRATE_DATABASE_URL, scoped to
# pbsms_test instead. A handful of e2e specs (billing/documents/
# guardian-access/tenant-lifecycle/transport) open a second, owner-role
# connection for FK-order-sensitive cleanup or verification queries the
# restricted pbsms_app role can't run — it must land on the same database
# as TEST_DATABASE_URL. Falls back to MIGRATE_DATABASE_URL when unset.
TEST_MIGRATE_DATABASE_URL=postgres://pbsms:pbsms_local_only@localhost:5432/pbsms_test

# PLATFORM_DATABASE_URL: pbsms_platform (0021_tenant_lifecycle.sql) — the
# ONLY role that can reach tenants/plans/platform_audit_logs (TEN-005).
# pbsms_app has zero grants on those tables by design. Used exclusively by
# modules/tenants/tenants.service.ts via PLATFORM_POOL.
PLATFORM_DATABASE_URL=postgres://pbsms_platform:pbsms_platform_local_only@localhost:5432/pbsms
# TEST_PLATFORM_DATABASE_URL: same NFR-DEP-010 pairing, for the two e2e
# specs (billing, tenant-lifecycle) that construct their service under
# test directly against the pbsms_platform role. Falls back to
# PLATFORM_DATABASE_URL when unset.
TEST_PLATFORM_DATABASE_URL=postgres://pbsms_platform:pbsms_platform_local_only@localhost:5432/pbsms_test

# WORKER_DATABASE_URL: pbsms_worker (0027_background_jobs.sql) — EXECUTE
# on dequeue_next_job()/complete_job()/evaluate_due_schedules(), plus
# (0048_product_feedback_digest.sql) plain SELECT on product_feedback and
# SELECT+INSERT on product_feedback_digests for the EC-100/101 digest job.
# Used exclusively by src/worker.ts, the genuinely separate process that
# satisfies FR-JOB-020 ("never on request-serving capacity") — never
# point apps/api's own main.ts at this role.
WORKER_DATABASE_URL=postgres://pbsms_worker:pbsms_worker_local_only@localhost:5432/pbsms
# WORKER_FEEDBACK_DIGEST_POLL_MS: how often src/worker.ts recomputes the
# EC-100/101 product-feedback digest. Optional, defaults to once a day
# (86400000ms) — the handler itself skips writing a row when nothing's
# new since the last one, so a shorter interval is safe for local testing.
# WORKER_FEEDBACK_DIGEST_POLL_MS=86400000

PG_POOL_MAX=10

# RATE_LIMIT_ENABLED: FR-API-040/NFR-PERF-010's global per-tenant/per-user
# request guard (common/rate-limit/rate-limit.guard.ts). Defaults to
# enabled; set to the literal string "false" as an operational kill
# switch if it ever needs to be disabled without a deploy.
# RATE_LIMIT_ENABLED=false

# --- Auth --------------------------------------------------------------
# Generate a real random value for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY

# --- App ---------------------------------------------------------------
PORT=3001

# --- Redis (cache / queues — Chapter 6.1, TEN-040) ----------------------
REDIS_URL=redis://localhost:6379

# --- Payment providers (Chapter 24.2) — sandbox credentials, per tenant in
# production; a single shared sandbox key set is fine for local dev only.
PAYSTACK_SECRET_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# --- Messaging (Chapter 26.1) --------------------------------------------
WHATSAPP_BSP_TOKEN=
SMS_AGGREGATOR_API_KEY=
