# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Env — never commit real secrets (SRS Chapter 33.4)
.env
.env.local
*.env

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# Postgres local volume artifacts if ever created outside Docker
*.pgdata/

# check-assistant-eval-integrity.ts's throwaway base-commit snapshot —
# always removed in its own finally block; ignored here only as a backstop
# against a leftover from a killed/crashed run.
apps/api/.assistant-eval-integrity-tmp-*/
